                { q: "下列現象中，與膠體性質無關的是？", options: ["晨霧中的光束", "江河入海口處形成沙洲", "用活性淨水劑淨化飲用水", "氯化鐵溶液中加入氫氧化鈉產生紅褐色沉澱"], answer: 3, explanation: "產生紅褐色沉澱是復分解沉澱反應，與膠體性質無關（但 Fe(OH)<sub>3</sub> 膠體聚沉會產生沉澱，不過此選項為直接混合反應）。" },
                { q: "下列關於分散系的說法，不正確的是？", options: ["溶液、膠體、濁液都屬於分散系", "分散系包括分散質和分散劑", "膠體屬於混合物", "膠體的分散質粒子不能透過半透膜"], answer: 3, explanation: "膠體的分散質粒子能透過濾紙，但不能透過半透膜。" },
                { q: "下列物質中，既能導電又屬於強電解質的是？", options: ["硫酸銅晶體", "熔融的氯化鈉", "無水乙醇", "鹽酸"], answer: 1, explanation: "熔融的氯化鈉含有自由移動離子，且自身是化合物電解質，故能導電且為強電解質（鹽酸是混合物）。" },
                { q: "下列離子方程式中，正確的是？", options: ["氧化鐵與鹽酸反應：Fe<sub>2</sub>O<sub>3</sub> + 6H<sup>+</sup> = 2Fe<sup>3+</sup> + 3H<sub>2</sub>O", "碳酸鈣與醋酸反應：CO<sub>3</sub><sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑", "氫氧化鈉與硫酸銅反應：Cu<sup>2+</sup> + 2OH<sup>-</sup> = Cu(OH)<sub>2</sub>↓", "氯氣通入水中：Cl<sub>2</sub> + H<sub>2</sub>O = 2H<sup>+</sup> + Cl<sup>-</sup> + ClO<sup>-</sup>"], answer: 0, explanation: "氧化鐵為難溶氧化物需寫化學式；弱酸醋酸與次氯酸不可拆。" },
                { q: "下列各組物質中，電解質在水溶液中的電離方程式正確的是？", options: ["NaHSO<sub>4</sub> = Na<sup>+</sup> + H<sup>+</sup> + SO<sub>4</sub><sup>2-</sup>", "NaHCO<sub>3</sub> = Na<sup>+</sup> + C<sup>4+</sup> + 3O<sup>2-</sup>", "CH<sub>3</sub>COOH = CH<sub>3</sub><sup>+</sup> + COO<sup>-</sup> + H<sup>+</sup>", "Ba(OH)<sub>2</sub> = Ba<sup>2+</sup> + OH<sub>2</sub><sup>2-</sup>"], answer: 0, explanation: "硫酸氫鈉在水溶液中完全電離出鈉離子、氫離子和硫酸根離子。" },
                { q: "下列物質中，屬於非電解質的是？", options: ["蔗糖", "氯化氫", "硫酸", "氫氧化鈉"], answer: 0, explanation: "蔗糖在水溶液和熔融狀態下均不導電，屬於非電解質。" },
                { q: "下列各組離子能在強酸性溶液中大量共存的是？", options: ["Na<sup>+</sup>、K<sup>+</sup>、OH<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>", "Mg<sup>2+</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup>、Na<sup>+</sup>", "Ba<sup>2+</sup>、Na<sup>+</sup>、CO<sub>3</sub><sup>2-</sup>、Cl<sup>-</sup>", "Fe<sup>2+</sup>、H<sup>+</sup>、NO<sub>3</sub><sup>-</sup>、SO<sub>4</sub><sup>2-</sup>"], answer: 1, explanation: "酸性溶液中不能大量存在 OH<sup>-</sup>、CO<sub>3</sub><sup>2-</sup>；Fe<sup>2+</sup>、H<sup>+</sup>、NO<sub>3</sub><sup>-</sup> 會發生氧化還原反應。故 Mg<sup>2+</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup>、Na<sup>+</sup> 可共存。" },
                { q: "下列反應中不屬於離子反應的是？", options: ["硫酸鈉與氯化鋇混合", "氫氣還原氧化銅", "鹽酸滴入碳酸鈉溶液中", "氨氣通入鹽酸中"], answer: 1, explanation: "氫氣還原氧化銅是氣固高溫加熱反應，不屬於離子反應。" },
                { q: "下列離子方程式適用於所有強酸與強鹼中和反應的是？", options: ["CH<sub>3</sub>COOH + OH<sup>-</sup> = CH<sub>3</sub>COO<sup>-</sup> + H<sub>2</sub>O", "2H<sup>+</sup> + Ba<sup>2+</sup> + 2OH<sup>-</sup> + SO<sub>4</sub><sup>2-</sup> = BaSO<sub>4</sub>↓ + 2H<sub>2</sub>O", "H<sup>+</sup> + OH<sup>-</sup> = H<sub>2</sub>O", "Mg<sup>2+</sup> + 2OH<sup>-</sup> = Mg(OH)<sub>2</sub>↓"], answer: 2, explanation: "強酸強鹼稀溶液中和反應的實質皆為 H<sup>+</sup> + OH<sup>-</sup> = H<sub>2</sub>O。" },
                { q: "下列關於丁達爾效應的說法，正確的是？", options: ["丁達爾效應是溶液的特性", "丁達爾效應是由於分散質粒子對光線散射造成的", "光束通過氯化鈉溶液時會產生丁達爾效應", "濁液也能產生明顯的丁達爾效應"], answer: 1, explanation: "丁達爾效應是膠體的特有光學性質，因膠體粒子對光線散射而形成。" },
                { q: "下列關於布朗運動的說法，正確的是？", options: ["布朗運動就是膠體粒子的熱運動", "布朗運動是分子受到周圍分子撞擊不平衡引起的", "溫度越高，布朗運動越緩慢", "溶液中的溶質離子也能發生明顯布朗運動"], answer: 1, explanation: "布朗運動是由分散劑分子從不同方向撞擊分散質粒子引起的無規則運動。" },
                { q: "下列物質中，不能導電的是？", options: ["氯化鈉溶液", "銅絲", "無水氯化氫氣體", "熔融硝酸鉀"], answer: 2, explanation: "無水氯化氫分子不電離，無自由移動離子，不導電。" },
                { q: "下列各組離子能在溶液中大量共存，且溶液為無色透明的是？", options: ["MnO<sub>4</sub><sup>-</sup>、K<sup>+</sup>、Na<sup>+</sup>、SO<sub>4</sub><sup>2-</sup>", "Fe<sup>3+</sup>、Cl<sup>-</sup>、Na<sup>+</sup>、NO<sub>3</sub><sup>-</sup>", "Mg<sup>2+</sup>、Cl<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>、Na<sup>+</sup>", "Cu<sup>2+</sup>、OH<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>、Na<sup>+</sup>"], answer: 2, explanation: "MnO<sub>4</sub><sup>-</sup> 紫色、Fe<sup>3+</sup> 黃色、Cu<sup>2+</sup> 藍色；Mg<sup>2+</sup>、Cl<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>、Na<sup>+</sup> 無色且互不反應。" },
                { q: "下列電解質分類正確的是？", options: ["強電解質：HCl、BaSO<sub>4</sub>、NaOH", "弱電解質：CH<sub>3</sub>COOH、H<sub>2</sub>O、NH<sub>3</sub>·H<sub>2</sub>O", "非電解質：SO<sub>2</sub>、酒精、CaCO<sub>3</sub>", "強電解質：HNO<sub>3</sub>、Ba(OH)<sub>2</sub>、蔗糖"], answer: 1, explanation: "碳酸鈣雖難溶但溶于水的部分完全電離，屬於強電解質；蔗糖是非電解質；BaSO<sub>4</sub> 難溶但也是強電解質。醋酸、水、一水合氨是弱電解質。" },
                { q: "下列反應對應的離子方程式正確的是？", options: ["大理石與醋酸反應：CO<sub>3</sub><sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑", "金屬鋁溶於氫氧化鈉溶液：2Al + 2OH<sup>-</sup> + 2H<sub>2</sub>O = 2AlO<sub>2</sub><sup>-</sup> + 3H<sub>2</sub>↑", "氯氣與水反應：Cl<sub>2</sub> + H<sub>2</sub>O = 2H<sup>+</sup> + Cl<sup>-</sup> + ClO<sup>-</sup>", "鐵與稀鹽酸反應：2Fe + 6H<sup>+</sup> = 2Fe<sup>3+</sup> + 3H<sub>2</sub>↑"], answer: 2, explanation: "此題考察高一氯氣水反應（註：次氯酸弱酸不可拆），且鐵與鹽酸反應生成亞鐵離子（Fe<sup>2+</sup>）。" },
                { q: "下列物質中，屬於酸性氧化物但常溫下不與水反應的是？", options: ["CO<sub>2</sub>", "SO<sub>3</sub>", "SiO<sub>2</sub>", "P<sub>2</sub>O<sub>5</sub>"], answer: 2, explanation: "二氧化矽（SiO<sub>2</sub>）是酸性氧化物，但不與水反應。" },
                { q: "下列說法中正確的是？", options: ["含有氧元素的化合物一定是氧化物", "混合物一定由多種分子組成", "電解質溶液能導電是由於溶液中有自由移動的離子", "能電離出氫離子的化合物一定是酸"], answer: 2, explanation: "電解質溶液導電實質是自由移動的離子定向移動。" },
                { q: "下列離子方程式改寫為化學方程式正確的是？", options: ["Ba<sup>2+</sup> + SO<sub>4</sub><sup>2-</sup> = BaSO<sub>4</sub>↓  $\rightarrow$  BaCl<sub>2</sub> + Na<sub>2</sub>SO<sub>4</sub> = BaSO<sub>4</sub>↓ + 2NaCl", "H<sup>+</sup> + OH<sup>-</sup> = H<sub>2</sub>O  $\rightarrow$  2HCl + Ba(OH)<sub>2</sub> = BaCl<sub>2</sub> + 2H<sub>2</sub>O", "CO<sub>3</sub><sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑  $\rightarrow$  CaCO<sub>3</sub> + 2HCl = CaCl<sub>2</sub> + H<sub>2</sub>O + CO<sub>2</sub>↑", "Mg<sup>2+</sup> + 2OH<sup>-</sup> = Mg(OH)<sub>2</sub>↓  $\rightarrow$  MgCl<sub>2</sub> + 2NaOH = Mg(OH)<sub>2</sub>↓ + 2NaCl"], answer: 0, explanation: "離子方程式能正確對應其實際化學反應及可溶性鹽搭配。" },
                { q: "下列各組反應中，不能用同一離子方程式表示的是？", options: ["氫氧化鈉與鹽酸；氫氧化鉀與硝酸", "碳酸鈣與鹽酸；碳酸鈉與硝酸", "硫酸與氫氧化鋇；硫酸銅與氫氧化鋇", "醋酸與氫氧化鈉；鹽酸與氨水"], answer: 3, explanation: "醋酸是弱酸不能拆，鹽酸是強酸可拆，故不能用同一離子方程式表示。" },
                { q: "下列物質露置在空氣中，因發生氧化還原反應而變質的是？", options: ["濃硫酸", "生石灰", "硫酸亞鐵溶液", "氯化鈉"], answer: 2, explanation: "硫酸亞鐵溶液（Fe<sup>2+</sup>）易被空氣中的氧氣氧化為鐵離子（Fe<sup>3+</sup>）。" },
                { q: "下列離子在給定條件下能大量共存的是？", options: ["pH = 1 的溶液中：Fe<sup>2+</sup>、Mg<sup>2+</sup>、MnO<sub>4</sub><sup>-</sup>、Cl<sup>-</sup>", "含有大量 Ba<sup>2+</sup> 的溶液中：Na<sup>+</sup>、K<sup>+</sup>、SO<sub>4</sub><sup>2-</sup>、Cl<sup>-</sup>", "含有大量 OH<sup>-</sup> 的溶液中：Na<sup>+</sup>、Cu<sup>2+</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup>", "水的離子積因溫度升高而變大的溶液中：Na<sup>+</sup>、K<sup>+</sup>、Cl<sup>-</sup>、HCO<sub>3</sub><sup>-</sup>"], answer: 3, explanation: "pH=1 含 H<sup>+</sup> 與 MnO<sub>4</sub><sup>-</sup> 會發生氧化還原；Ba<sup>2+</sup> 與 SO<sub>4</sub><sup>2-</sup> 沉澱；Cu<sup>2+</sup> 與 OH<sup>-</sup> 沉澱。HCO<sub>3</sub><sup>-</sup> 在鹼性中不共存，但在中性或弱鹼/升溫水溶液中可穩定。" },
                { q: "下列關於離子反應不正確說法是？", options: ["離子反應總是有沉澱、氣體或水生成", "離子反應可使某些離子濃度降低", "離子方程式只需遵循質量守恆", "複分解型離子反應實質是向離子濃度減小的方向進行"], answer: 2, explanation: "離子方程式書寫必須同時遵循質量守恆與電荷守恆。" },
                { q: "下列離子方程式書寫正確且符合事實的是？", options: ["向碳酸氫鈉溶液中滴加稀鹽酸：HCO<sub>3</sub><sup>-</sup> + H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑", "氯氣與水反應：Cl<sub>2</sub> + H<sub>2</sub>O = 2H<sup>+</sup> + Cl<sup>-</sup> + ClO<sup>-</sup>", "鐵粉加入三氯化鐵溶液中：Fe + Fe<sup>3+</sup> = 2Fe<sup>2+</sup>", "碳酸鈣溶於醋酸中：CO<sub>3</sub><sup>2-</sup> + 2CH<sub>3</sub>COOH = Ca<sup>2+</sup> + 2CH<sub>3</sub>COO<sup>-</sup> + H<sub>2</sub>O + CO<sub>2</sub>↑"], answer: 0, explanation: "碳酸氫根與氫離子反應生成水和二氧化碳。" },
                { q: "下列各組微粒在指定溶液中一定能大量共存的是？", options: ["使甲基橙呈紅色的溶液中：I<sup>-</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup>、Na<sup>+</sup>", "常溫下由水电離出的 c(H<sup>+</sup>) = 10<sup>-12</sup> mol/L 的溶液中：Na<sup>+</sup>、K<sup>+</sup>、Cl<sup>-</sup>、AlO<sub>2</sub><sup>-</sup>", "含有大量 Fe<sup>3+</sup> 的溶液中：SCN<sup>-</sup>、Na<sup>+</sup>、Cl<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>", "與 Al 反應能放出 H<sub>2</sub> 的溶液中：NH<sub>4</sub><sup>+</sup>、Na<sup>+</sup>、CO<sub>3</sub><sup>2-</sup>、Cl<sup>-</sup>"], answer: 1, explanation: "甲基橙呈紅色說明是強酸性，H<sup>+</sup>、I<sup>-</sup>、NO<sub>3</sub><sup>-</sup> 會發生氧化還原；Fe<sup>3+</sup> 與 SCN<sup>-</sup> 顯紅色錯合物；放氫氣可能是酸也可能是強鹼，強鹼中 NH<sub>4</sub><sup>+</sup> 與 CO<sub>3</sub><sup>2-</sup> 不能共存。水电離受抑制說明是酸或鹼，AlO<sub>2</sub><sup>-</sup> 在強鹼中能大量共存。" },
                { q: "下列有關電解質的敘述正確的是？", options: ["導電能力強的溶液其電解質一定是強電解質", "強電解質溶液的導電能力一定比弱電解質溶液強", "化合物不一定都是電解質，電解質一定都是化合物", "非電解質在水溶液中和熔融狀態下均不能導電"], answer: 3, explanation: "非電解質在水溶液及熔融狀態下均不導電。" },
                { q: "下列離子方程式能正確表示其反應的是？", options: ["用小蘇打治療胃酸過多：HCO<sub>3</sub><sup>-</sup> + H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑", "向氯化鋁溶液中加入過量氨水：Al<sup>3+</sup> + 4OH<sup>-</sup> = AlO<sub>2</sub><sup>-</sup> + 2H<sub>2</sub>O", "向硫酸亞鐵溶液中通入氯氣：2Fe<sup>2+</sup> + Cl<sub>2</sub> = 2Fe<sup>3+</sup> + 2Cl<sup>-</sup>", "向碳酸鈉溶液中加入過量醋酸：CO<sub>3</sub><sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑"], answer: 2, explanation: "氯氣能將亞鐵離子氧化為鐵離子。氨水是弱鹼不能溶解氫氧化鋁沉澱；醋酸弱酸不能拆成 H<sup>+</sup>。" },
                { q: "下列物質分類的組合中，完全正確的是？", options: ["強電解質：明礬、冰醋酸、硫酸", "弱電解質：一水合氨、次氯酸、水", "非電解質：乾冰、三氧化硫、乙醇", "鹽：碳酸氫鈉、膽礬、過氧化鈉"], answer: 1, explanation: "冰醋酸是純醋酸屬於弱電解質；二氧化硫、三氧化硫是電解質；過氧化鈉是過氧化物（離子化合物屬鹽或特殊化合物）。一水合氨、次氯酸、水皆為弱電解質。" },
                { q: "下列反應的離子方程式正確的是？", options: ["鎂條插入硫酸銅溶液中：Mg + Cu<sup>2+</sup> = Mg<sup>2+</sup> + Cu", "氧化鎂與稀硫酸反應：O<sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O", "碳酸鈣與稀硝酸反應：CO<sub>3</sub><sup>2-</sup> + 2H<sup>+</sup> = H<sub>2</sub>O + CO<sub>2</sub>↑", "硫酸氫鈉溶液與氫氧化鈉溶液混合：H<sup>+</sup> + OH<sup>-</sup> = H<sub>2</sub>O"], answer: 0, explanation: "鎂比銅活潑，置換出銅離子。氧化鎂為難溶物需寫化學式；硫酸氫鈉電離出的 H<sup>+</sup> 與 OH<sup>-</sup> 反應實質為 H<sup>+</sup> + OH<sup>-</sup> = H<sub>2</sub>O（但完全離子方程式應體現 HSO<sub>4</sub><sup>-</sup> + OH<sup>-</sup> = SO<sub>4</sub><sup>2-</sup> + H<sub>2</sub>O）。" },
                { q: "下列關於分散系的說法中，正確的是？", options: ["分散質粒子直徑小於 1 nm 的分散系屬膠體", "光束通過膠體時可見一條光亮的通路", "濁液的分散質粒子能透過濾紙", "溶液中分散質粒子帶電荷"], answer: 1, explanation: "光束通過膠體能產生丁達爾效應（光亮的通路）。" },
                { q: "下列各組離子在溶液中能大量共存，且加入鐵粉能放出氫氣的是？", options: ["Mg<sup>2+</sup>、Cl<sup>-</sup>、SO<sub>4</sub><sup>2-</sup>、Na<sup>+</sup>", "H<sup>+</sup>、Ba<sup>2+</sup>、NO<sub>3</sub><sup>-</sup>、Cl<sup>-</sup>", "K<sup>+</sup>、Na<sup>+</sup>、CO<sub>3</sub><sup>2-</sup>、NO<sub>3</sub><sup>-</sup>", "H<sup>+</sup>、Cl<sup>-</sup>、Na<sup>+</sup>、SO<sub>4</sub><sup>2-</sup>"], answer: 3, explanation: "加鐵粉能放出氫氣說明溶液呈強酸性（含有大量 H<sup>+</sup>），選項 3 中 H<sup>+</sup>、Cl<sup>-</sup>、Na<sup>+</sup>、SO<sub>4</sub><sup>2-</sup> 彼此能大量共存且遇鐵放出氫氣。" },
                { q: "下列有關電解質的敘述，正確的是？", options: ["純液態的氯化氫能導電", "碳酸鈣水溶液導電性很好，故為強電解質", "氯化鈉在水溶液中和熔融狀態下都能電離出自由移動的離子", "銅能導電，故銅是電解質"], answer: 2, explanation: "氯化鈉在水溶液或熔融狀態下均能電離出自由移動的離子而導電。" },
                { q: "下列各組離子反應方程式（離子方程式）與事實相符的是？", options: ["碳酸氫鈣溶液中加入過量氫氧化鈉：Ca<sup>2+</sup> + HCO<sub>3</sub><sup>-</sup> + OH<sup>-</sup> = CaCO<sub>3</sub>↓ + H<sub>2</sub>O", "稀硝酸與亞硫酸鈉反應：2H<sup>+</sup> + SO<sub>3</sub><sup>2-</sup> = H<sub>2</sub>O + SO<sub>2</sub>↑", "氯化鐵溶液中加入銅粉：Fe<sup>3+</sup> + Cu = Fe<sup>2+</sup> + Cu<sup>2+</sup>", "少量二氧化碳通入氯化鈣溶液中：CO<sub>2</sub> + H<sub>2</sub>O + Ca<sup>2+</sup> = CaCO<sub>3</sub>↓ + 2H<sup>+</sup>"], answer: 0, explanation: "碳酸氫鈣與過量氫氧化鈉反應生成碳酸鈣沉澱、碳酸鈉與水。硝酸會將亞硫酸根氧化；銅與鐵離子反應需電荷守恆（2Fe<sup>3+</sup> + Cu = 2Fe<sup>2+</sup> + Cu<sup>2+</sup>）；CO<sub>2</sub> 不與 CaCl<sub>2</sub> 反應。" },
                { q: "下列關於酸雨的說法，正確的是？", options: ["pH < 7 的雨水稱為酸雨", "酸雨主要由二氧化碳溶於水形成", "酸雨主要是由化石燃料燃燒產生的 SO<sub>2</sub> 和 NO<sub>x</sub> 引起的", "酸雨會促使土壤肥力增加"], answer: 2, explanation: "酸雨是 pH < 5.6 的降水，主要由 SO<sub>2</sub> 與氮氧化物引發。" },
                { q: "下列化學反應中，不屬於氧化還原反應的是？", options: ["2NO + O<sub>2</sub> = 2NO<sub>2</sub>", "Cl<sub>2</sub> + 2NaOH = NaCl + NaClO + H<sub>2</sub>O", "CuSO<sub>4</sub> + 2NaOH = Cu(OH)<sub>2</sub>↓ + Na<sub>2</sub>SO<sub>4</sub>", "2Na + 2H<sub>2</sub>O = 2NaOH + H<sub>2</sub>↑"], answer: 2, explanation: "硫酸銅與氫氧化鈉反應是複分解反應，各元素化合價前後無變化。" },
                { q: "下列各組物質中，因發生化學反應而能使溴水褪色的是？", options: ["乙烯、二氧化硫、苯", "甲烷、乙烯、氯化氫", "乙烯、二氧化硫、硫酸亞鐵溶液", "苯、四氯化碳、乙烯"], answer: 2, explanation: "乙烯發生加成褪色，二氧化硫與硫酸亞鐵具還原性可使溴水還原褪色。" },
                { q: "下列關於離子共存的判斷，正確的是？", options: ["能使紫色石蕊試液變紅的溶液中：Fe<sup>3+</sup>、Na<sup>+</sup>、SO<sub>4</sub><sup>2-</sup>、I<sup>-</sup>", "常溫下水的離子積常數 K<sub>w</sub> = 10<sup>-14</sup> 的溶液中：Na<sup>+</sup>、K<sup>+</sup>、Cl<sup>-</sup>、AlO<sub>2</sub><sup>-</sup>", "滴加 KSCN 溶液顯紅色的溶液中：NH<sub>4</sub><sup>+</sup>、K<sup>+</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup>", "含有大量 Fe<sup>2+</sup> 的溶液中：H<sup>+</sup>、NO<sub>3</sub><sup>-</sup>、SO<sub>4</sub><sup>2-</sup>、Cl<sup>-</sup>"], answer: 2, explanation: "石蕊變紅為酸性，H<sup>+</sup>、I<sup>-</sup>、NO<sub>3</sub><sup>-</sup> 氧化還原不共存；H<sup>+</sup>、NO<sub>3</sub><sup>-</sup> 與 Fe<sup>2+</sup> 不共存；遇 KSCN 顯紅色說明含 Fe<sup>3+</sup>，與 NH<sub>4</sub><sup>+</sup>、K<sup>+</sup>、Cl<sup>-</sup>、NO<sub>3</sub><sup>-</sup> 不反應可大量共存。" }
            ]
        };

        const encouragements = [
            "太棒了！化學之星就是你！",
            "反應完美，思維敏捷！",
            "觀點精準，完全命中！",
            "實驗大師，再接再厲！",
            "化學原理掌握得爐火純青！"
        ];

        let currentScreen = 'screen-home';
        let playerName = '';
        let gameDifficulty = 'easy';
        let activeQuestions = [];
        let currentIndex = 0;
        let score = 0;
        let wrongQuestions = [];
        let answeredCurrent = false;
        let timerInterval = null;
        let timeLeft = 0;
        let maxTimePerQ = 15; // 預設簡單

        function goToScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            const targetScreen = document.getElementById(screenId);
            if (targetScreen) {
                targetScreen.classList.add('active');
                currentScreen = screenId;
            }
            if (screenId !== 'screen-result') {
                stopFireworks();
            }
        }

        function checkEnter(event) {
            if (event.key === 'Enter') {
                validateName();
            }
        }

        function validateName() {
            initAudio();
            if (isAudioEnabled && !bgmInterval) {
                playBGM();
            }

            const nameInput = document.getElementById('player-name');
            const errorTip = document.getElementById('name-error-tip');
            const nameVal = nameInput.value.trim();
            if (!nameVal) {
                errorTip.innerText = "⚠️ 請輸入您的名字或座號才能繼續！";
                nameInput.focus();
                return;
            }
            errorTip.innerText = "";
            playerName = nameVal;
            goToScreen('screen-difficulty');
        }

        // 每次開始遊戲：隨機洗牌並抽選 5 題，且簡單與困難總滿分對等（均為 100 分：每題 20 分）
        function startGame(difficulty) {
            gameDifficulty = difficulty;
            let pool = [...questionBank[difficulty]];
            for (let i = pool.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [pool[i], pool[j]] = [pool[j], pool[i]];
            }

            const count = 5; // 每局 5 題
            activeQuestions = pool.slice(0, count);

            currentIndex = 0;
            score = 0;
            wrongQuestions = [];
            // 簡單模式 15 秒/題，困難模式 10 秒/題
            maxTimePerQ = (difficulty === 'easy') ? 15 : 10;

            document.getElementById('ui-player').innerText = playerName;
            goToScreen('screen-game');
            loadQuestion();
        }

        function loadQuestion() {
            answeredCurrent = false;
            const qData = activeQuestions[currentIndex];
            
            document.getElementById('ui-progress').innerText = `${currentIndex + 1}/${activeQuestions.length}`;
            document.getElementById('ui-score').innerText = score;
            document.getElementById('ui-question').innerHTML = qData.q;

            const optionsContainer = document.getElementById('ui-options');
            optionsContainer.innerHTML = '';

            qData.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerHTML = opt;
                btn.onclick = () => selectAnswer(idx);
                optionsContainer.appendChild(btn);
            });

            document.getElementById('ui-feedback').classList.remove('show');
            document.getElementById('next-btn').style.display = 'none';

            startTimer();
        }

        function startTimer() {
            clearInterval(timerInterval);
            timeLeft = maxTimePerQ;
            const timerBar = document.getElementById('timer-bar');
            timerBar.style.width = '100%';

            timerInterval = setInterval(() => {
                timeLeft--;
                const percent = (timeLeft / maxTimePerQ) * 100;
                timerBar.style.width = `${percent}%`;

                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    handleTimeout();
                }
            }, 1000);
        }

        function handleTimeout() {
            if (answeredCurrent) return;
            answeredCurrent = true;
            playWrongSound();

            const qData = activeQuestions[currentIndex];
            const buttons = document.querySelectorAll('.option-btn');
            if (buttons[qData.answer]) {
                buttons[qData.answer].classList.add('correct');
            }

            wrongQuestions.push({
                q: qData.q,
                userAns: "超時未作答",
                correctAns: qData.options[qData.answer],
                explanation: qData.explanation
            });

            document.getElementById('encouragement-text').innerText = "⏱️ 哎呀，時間到！";
            document.getElementById('encouragement-text').style.color = "var(--danger)";
            document.getElementById('feedback-title').innerText = "❌ 回答超時！";
            document.getElementById('feedback-title').style.color = "var(--danger)";
            document.getElementById('feedback-desc').innerHTML = `<b>知識解析：</b>${qData.explanation}`;
            document.getElementById('ui-feedback').classList.add('show');
            document.getElementById('next-btn').style.display = 'block';
        }

        function selectAnswer(selectedIndex) {
            if (answeredCurrent) return;
            answeredCurrent = true;
            clearInterval(timerInterval);

            const qData = activeQuestions[currentIndex];
            const buttons = document.querySelectorAll('.option-btn');
            // 滿分100分，共5題，每題20分（高低難度總分平衡）
            const pointsPerQ = 20;

            if (selectedIndex === qData.answer) {
                playCorrectSound();
                buttons[selectedIndex].classList.add('correct');
                score += pointsPerQ;
                
                const randomEnc = encouragements[Math.floor(Math.random() * encouragements.length)];
                document.getElementById('encouragement-text').innerText = randomEnc;
                document.getElementById('encouragement-text').style.color = "var(--accent)";
                document.getElementById('feedback-title').innerText = "✔ 回答正確！";
                document.getElementById('feedback-title').style.color = "var(--accent)";
            } else {
                playWrongSound();
                buttons[selectedIndex].classList.add('wrong');
                if (buttons[qData.answer]) {
                    buttons[qData.answer].classList.add('correct');
                }

                wrongQuestions.push({
                    q: qData.q,
                    userAns: qData.options[selectedIndex],
                    correctAns: qData.options[qData.answer],
                    explanation: qData.explanation
                });

                document.getElementById('encouragement-text').innerText = "💡 沒關係，失敗為成功之母！";
                document.getElementById('encouragement-text').style.color = "var(--danger)";
                document.getElementById('feedback-title').innerText = "❌ 回答錯誤！";
                document.getElementById('feedback-title').style.color = "var(--danger)";
            }

            document.getElementById('ui-score').innerText = score;
            document.getElementById('feedback-desc').innerHTML = `<b>知識解析：</b>${qData.explanation}`;
            document.getElementById('ui-feedback').classList.add('show');
            document.getElementById('next-btn').style.display = 'block';
        }

        function nextQuestion() {
            currentIndex++;
            if (currentIndex < activeQuestions.length) {
                loadQuestion();
            } else {
                endGame();
            }
        }

        function endGame() {
            goToScreen('screen-result');
            document.getElementById('final-score-text').innerText = `最終得分：${score} 分`;
            
            let comment = "";
            if (score >= 90) {
                comment = "太強了！化學概念掌握得無懈可擊，化學實驗室大師！";
                document.getElementById('result-emoji').innerText = "🌟";
                startFireworks();
            } else if (score >= 60) {
                comment = "表現優異！基礎與深化知識都有水準以上的發揮！";
                document.getElementById('result-emoji').innerText = "🧪";
                startFireworks();
            } else {
                comment = "革命尚未成功，建議多複習錯題筆記，再挑戰一次！";
                document.getElementById('result-emoji').innerText = "💡";
            }
            document.getElementById('result-comment').innerText = comment;

            const wrongBtn = document.getElementById('wrong-book-btn');
            wrongBtn.style.display = (wrongQuestions.length > 0) ? 'block' : 'none';

            saveToLeaderboard(playerName, score);
        }

        function saveToLeaderboard(name, sc) {
            try {
                let lb = JSON.parse(localStorage.getItem('chem_high_leaderboard') || '[]');
                lb.push({ name: name, score: sc, date: new Date().toLocaleDateString() });
                lb.sort((a, b) => b.score - a.score);
                lb = lb.slice(0, 5);
                localStorage.setItem('chem_high_leaderboard', JSON.stringify(lb));
            } catch (e) {}
        }

        function showLeaderboard() {
            goToScreen('screen-leaderboard');
            let lb = [];
            try {
                lb = JSON.parse(localStorage.getItem('chem_high_leaderboard') || '[]');
            } catch (e) {}
            
            const container = document.getElementById('leaderboard-content');

            if (lb.length === 0) {
                container.innerHTML = `<p style="margin: 20px 0;">目前尚無排行榜紀錄，快來挑戰第一名吧！</p>`;
                return;
            }

            let html = `
                <table>
                    <thead>
                        <tr>
                            <th>名次</th>
                            <th>實驗員</th>
                            <th>得分</th>
                            <th>日期</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            lb.forEach((item, index) => {
                html += `
                    <tr>
                        <td>#${index + 1}</td>
                        <td>${item.name}</td>
                        <td style="color: var(--primary); font-weight: bold;">${item.score}</td>
                        <td>${item.date}</td>
                    </tr>
                `;
            });

            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function showWrongBook() {
            goToScreen('screen-wrong-book');
            const container = document.getElementById('wrong-list-content');
            let html = '';

            wrongQuestions.forEach((item, index) => {
                html += `
                    <div style="background: rgba(46, 42, 93, 0.8); border: 1px solid rgba(255,255,255,0.15); padding: 15px; border-radius: 14px; margin-bottom: 12px; text-align: left;">
                        <p style="color: var(--text-main); font-weight: bold; margin-bottom: 5px;">Q${index + 1}. ${item.q}</p>
                        <p style="color: var(--danger); margin-bottom: 3px;">您的選擇：${item.userAns}</p>
                        <p style="color: var(--accent); margin-bottom: 5px;">正確答案：${item.correctAns}</p>
                        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0;"><b>解析：</b>${item.explanation}</p>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // ------------------ 通關煙花特效 ------------------
        let fwCanvas, fwCtx, fireworksAnimId;
        let particles = [];

        function startFireworks() {
            fwCanvas = document.getElementById('fireworks-canvas');
            if (!fwCanvas) return;
            fwCanvas.style.display = 'block';
            fwCtx = fwCanvas.getContext('2d');
            fwCanvas.width = fwCanvas.parentElement.clientWidth;
            fwCanvas.height = fwCanvas.parentElement.clientHeight;

            particles = [];
            for (let i = 0; i < 50; i++) {
                particles.push({
                    x: fwCanvas.width / 2,
                    y: fwCanvas.height / 2,
                    vx: (Math.random() - 0.5) * 8,
                    vy: (Math.random() - 0.5) * 8,
                    alpha: 1,
                    color: `hsl(${Math.random() * 360}, 100%, 65%)`
                });
            }

            loopFireworks();
        }

        function loopFireworks() {
            if (!fwCtx || !fwCanvas) return;
            fwCtx.clearRect(0, 0, fwCanvas.width, fwCanvas.height);
            particles.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                p.vy += 0.1;
                p.alpha -= 0.02;

                fwCtx.save();
                fwCtx.globalAlpha = Math.max(p.alpha, 0);
                fwCtx.fillStyle = p.color;
                fwCtx.beginPath();
                fwCtx.arc(p.x, p.y, 4, 0, Math.PI * 2);
                fwCtx.fill();
                fwCtx.restore();
            });

            particles = particles.filter(p => p.alpha > 0);
            if (particles.length > 0) {
                fireworksAnimId = requestAnimationFrame(loopFireworks);
            } else {
                if (currentScreen === 'screen-result') {
                    for (let i = 0; i < 40; i++) {
                        particles.push({
                            x: Math.random() * fwCanvas.width,
                            y: Math.random() * (fwCanvas.height / 2),
                            vx: (Math.random() - 0.5) * 6,
                            vy: (Math.random() - 0.5) * 6,
                            alpha: 1,
                            color: `hsl(${Math.random() * 360}, 100%, 65%)`
                        });
                    }
                    fireworksAnimId = requestAnimationFrame(loopFireworks);
                }
            }
        }

        function stopFireworks() {
            if (fireworksAnimId) {
                cancelAnimationFrame(fireworksAnimId);
            }
            if (fwCanvas) {
                fwCanvas.style.display = 'none';
            }
        }
    </script>
</body>
</html>
