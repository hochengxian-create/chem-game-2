<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>化學實驗室大冒險 - 可愛高一化學互動遊戲</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --panel-bg: rgba(30, 27, 75, 0.85);
            --primary: #38bdf8;
            --primary-hover: #0ea5e9;
            --accent: #34d399;
            --danger: #fb7185;
            --text-main: #ffffff;
            --text-muted: #cbd5e1;
            --border: rgba(56, 189, 248, 0.4);
            --shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(56, 189, 248, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            user-select: none;
        }

        /* 絢麗動態漸變背景與輕量化化學氣泡 */
        body {
            background: linear-gradient(135deg, #0f172a, #311042, #1e1b4b, #06283d);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
            padding: 20px;
            position: relative;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* 浮動泡泡背景裝飾 */
        .bubble {
            position: absolute;
            bottom: -50px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            pointer-events: none;
            animation: rise 8s infinite linear;
        }
        @keyframes rise {
            0% { transform: translateY(0) scale(1); opacity: 0.8; }
            100% { transform: translateY(-105vh) scale(1.5); opacity: 0; }
        }

        .container {
            width: 100%;
            max-width: 850px;
            background: var(--panel-bg);
            border: 2px solid var(--border);
            border-radius: 30px;
            box-shadow: var(--shadow);
            padding: 40px 30px 30px 30px;
            position: relative;
            z-index: 2;
            animation: fadeIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            backdrop-filter: blur(16px);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(25px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .audio-control {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            transition: all 0.2s;
            font-weight: bold;
        }
        .audio-control:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.05);
        }

        h1, h2, h3 {
            text-align: center;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        h1 {
            font-size: 2.4rem;
            background: linear-gradient(135deg, #38bdf8, #f472b6, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(56, 189, 248, 0.4);
        }

        p {
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 15px;
            text-align: center;
        }

        .screen {
            display: none;
        }

        .screen.active {
            display: block;
            animation: slideIn 0.4s ease-out;
        }

        @keyframes slideIn {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }

        /* 立體Q彈按鈕 */
        .btn {
            display: block;
            width: 100%;
            padding: 16px 24px;
            margin: 15px 0;
            background: linear-gradient(135deg, #6366f1, #a855f7);
            color: white;
            border: none;
            border-radius: 20px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 6px 0 #4338ca, 0 12px 25px rgba(0,0,0,0.3);
            transition: all 0.1s ease;
            text-align: center;
        }

        .btn:hover {
            filter: brightness(1.1);
            transform: translateY(-2px);
            box-shadow: 0 8px 0 #4338ca, 0 15px 30px rgba(99, 102, 241, 0.4);
        }

        .btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 #4338ca, 0 5px 10px rgba(0,0,0,0.3);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #64748b, #475569);
            box-shadow: 0 6px 0 #334155, 0 12px 25px rgba(0,0,0,0.3);
        }
        .btn-secondary:active {
            box-shadow: 0 2px 0 #334155, 0 5px 10px rgba(0,0,0,0.3);
        }

        .btn-accent {
            background: linear-gradient(135deg, #34d399, #059669);
            box-shadow: 0 6px 0 #047857, 0 12px 25px rgba(0,0,0,0.3);
        }
        .btn-accent:active {
            box-shadow: 0 2px 0 #047857, 0 5px 10px rgba(0,0,0,0.3);
        }

        .input-group {
            margin: 25px 0;
        }

        input[type="text"] {
            width: 100%;
            padding: 16px;
            background: rgba(15, 23, 42, 0.6);
            border: 2px solid rgba(56, 189, 248, 0.5);
            border-radius: 16px;
            color: white;
            font-size: 1.2rem;
            text-align: center;
            outline: none;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
            box-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
        }

        .game-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
            margin-bottom: 15px;
            padding: 12px 18px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 14px;
            font-size: 1.05rem;
            color: var(--text-muted);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .game-header span {
            color: var(--primary);
            font-weight: bold;
        }

        .timer-container {
            width: 100%;
            height: 10px;
            background: rgba(15, 23, 42, 0.6);
            border-radius: 5px;
            margin-bottom: 20px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .timer-bar {
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, #38bdf8, #34d399);
            transition: width 1s linear;
        }

        .question-box {
            background: rgba(15, 23, 42, 0.6);
            border: 2px solid rgba(56, 189, 248, 0.3);
            padding: 25px;
            border-radius: 20px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.25rem;
            font-weight: bold;
            box-shadow: inset 0 3px 12px rgba(0,0,0,0.5);
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .option-btn {
            background: rgba(59, 53, 122, 0.7);
            border: 2px solid rgba(255, 255, 255, 0.15);
            padding: 18px;
            border-radius: 16px;
            color: white;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.2s;
            text-align: center;
            box-shadow: 0 6px 15px rgba(0,0,0,0.25);
        }

        .option-btn:hover {
            border-color: var(--primary);
            background: rgba(76, 68, 145, 0.9);
            transform: translateY(-2px);
        }

        .option-btn.correct {
            background: #059669 !important;
            border-color: var(--accent) !important;
            box-shadow: 0 0 25px rgba(52, 211, 153, 0.6);
        }

        .option-btn.wrong {
            background: #e11d48 !important;
            border-color: var(--danger) !important;
            box-shadow: 0 0 25px rgba(251, 113, 133, 0.6);
        }

        .feedback-box {
            margin-top: 20px;
            padding: 18px;
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.7);
            border-left: 6px solid var(--primary);
            display: none;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .feedback-box.show {
            display: block;
            animation: fadeIn 0.3s ease-out;
        }

        .encouragement-tag {
            display: inline-block;
            background: rgba(52, 211, 153, 0.2);
            color: var(--accent);
            padding: 4px 12px;
            border-radius: 10px;
            font-size: 0.95rem;
            margin-bottom: 8px;
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            background: rgba(15, 23, 42, 0.6);
            border-radius: 16px;
            overflow: hidden;
        }

        th, td {
            padding: 14px 15px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        th {
            background: #3b357a;
            color: var(--primary);
        }

        tr:last-child td {
            border-bottom: none;
        }

        .error-tip {
            color: var(--danger);
            font-size: 0.95rem;
            text-align: center;
            margin-top: 5px;
            min-height: 20px;
        }

        #fireworks-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            display: none;
            border-radius: 30px;
            z-index: 10;
        }

        @media (max-width: 600px) {
            .options-grid {
                grid-template-columns: 1fr;
            }
            .container {
                padding: 25px 15px 20px 15px;
            }
            h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

    <!-- 背景動態氣泡 -->
    <div class="bubble" style="left: 10%; width: 25px; height: 25px; animation-duration: 7s;"></div>
    <div class="bubble" style="left: 30%; width: 40px; height: 40px; animation-duration: 10s; animation-delay: 2s;"></div>
    <div class="bubble" style="left: 55%; width: 20px; height: 20px; animation-duration: 6s; animation-delay: 1s;"></div>
    <div class="bubble" style="left: 75%; width: 35px; height: 35px; animation-duration: 9s; animation-delay: 3s;"></div>
    <div class="bubble" style="left: 90%; width: 30px; height: 30px; animation-duration: 8s; animation-delay: 4s;"></div>

    <div class="container">
        <canvas id="fireworks-canvas"></canvas>

        <div class="top-bar">
            <span style="font-size: 1.2rem; font-weight: bold; color: #f472b6;">🧪 萌系化學實驗室</span>
            <button class="audio-control" onclick="toggleAudio()">🔊 音效：開啟</button>
        </div>

        <!-- 1. 首頁畫面 -->
        <div id="screen-home" class="screen active">
            <h1>化學實驗室大冒險 ✨</h1>
            <p>初高中銜接與高一核心化學趣味互動系統</p>
            <div style="margin: 25px 0; text-align: center;">
                <span style="font-size: 4.5rem; filter: drop-shadow(0 0 25px rgba(56,189,248,0.5));">🦄⚗️</span>
            </div>
            <button class="btn" onclick="goToScreen('screen-intro')">🚀 進入遊戲說明</button>
            <button class="btn btn-secondary" onclick="showLeaderboard()">🏆 查看英雄排行榜</button>
        </div>

        <!-- 2. 遊戲介紹頁 -->
        <div id="screen-intro" class="screen">
            <h2>📜 遊戲規則與說明</h2>
            <p>歡迎來到可愛又刺激的化學實驗挑戰！本系統包含兩大化學模組：</p>
            <p><b>1. 基礎鞏固模組（初三銜接）：</b>元素符號、化合價、離子、溶解性口訣。</p>
            <p><b>2. 高一深化模組（核心推理）：</b>電離方程式、膠體、丁達爾效應、布朗運動、離子共存、酸鹼鹽反應。</p>
            <p><b>✨ 亮點機制：</b>每題隨機抽題不重複、簡單15秒/困難10秒倒數計時、滿分對等平衡、歡快音效、錯題筆記與通關煙花！</p>
            <button class="btn" onclick="goToScreen('screen-name')">👉 開始挑戰</button>
            <button class="btn btn-secondary" onclick="goToScreen('screen-home')">🏠 返回首頁</button>
        </div>

        <!-- 3. 輸入玩家姓名 -->
        <div id="screen-name" class="screen">
            <h2>🏷️ 登記實驗員身份</h2>
            <p>請輸入您的名字或座號，以便記錄排行榜成績：</p>
            <div class="input-group">
                <input type="text" id="player-name" placeholder="例如：高一化學組 — 小明" maxlength="15" onkeypress="checkEnter(event)">
                <div class="error-tip" id="name-error-tip"></div>
            </div>
            <button class="btn" onclick="validateName()">➡️ 下一步：選擇挑戰難度</button>
            <button class="btn btn-secondary" onclick="goToScreen('screen-intro')">⬅️ 回上頁</button>
        </div>

        <!-- 4. 選擇難度 -->
        <div id="screen-difficulty" class="screen">
            <h2>⚡ 選擇挑戰難度級別</h2>
            <p>兩套獨立題庫（各 50 題），每次進入隨機洗牌抽題：</p>
            
            <button class="btn btn-accent" onclick="startGame('easy')">
                <b>🟢 簡單模式（基礎鞏固）</b><br>
                <span style="font-size: 0.9rem; opacity: 0.9;">15秒/題，總分滿分 100 分</span>
            </button>
            <button class="btn" onclick="startGame('hard')">
                <b>🔴 困難模式（高一核心推理）</b><br>
                <span style="font-size: 0.9rem; opacity: 0.9;">10秒/題，總分滿分 100 分</span>
            </button>
            <button class="btn btn-secondary" onclick="goToScreen('screen-name')">⬅️ 回上頁</button>
        </div>

        <!-- 5. 遊戲闖關主畫面 -->
        <div id="screen-game" class="screen">
            <div class="game-header">
                <div>實驗員：<span id="ui-player"></span></div>
                <div>進度：<span id="ui-progress">1/5</span></div>
                <div>得分：<span id="ui-score">0</span></div>
            </div>

            <div class="timer-container">
                <div class="timer-bar" id="timer-bar"></div>
            </div>

            <div class="question-box" id="ui-question">
                載入中...
            </div>

            <div class="options-grid" id="ui-options">
                <!-- 動態選項 -->
            </div>

            <div class="feedback-box" id="ui-feedback">
                <div class="encouragement-tag" id="encouragement-text">太棒了！</div>
                <div id="feedback-title" style="font-weight: bold; font-size: 1.1rem;"></div>
                <p id="feedback-desc" style="margin-top: 8px; margin-bottom: 0; text-align: left;"></p>
            </div>

            <button class="btn btn-accent" id="next-btn" style="display: none; margin-top: 20px;" onclick="nextQuestion()">➡️ 下一題</button>
        </div>

        <!-- 6. 成績結算頁 -->
        <div id="screen-result" class="screen">
            <h2>🎉 實驗結算報告</h2>
            <div style="text-align: center; margin: 20px 0; position: relative; z-index: 11;">
                <span style="font-size: 4rem;" id="result-emoji">🏆</span>
                <h3 id="final-score-text" style="font-size: 2.2rem; margin-top: 10px; color: var(--primary);">最終得分：100分</h3>
                <p id="result-comment" style="margin-top: 10px; font-size: 1.1rem;"></p>
            </div>
            <div style="position: relative; z-index: 11;">
                <button class="btn" id="wrong-book-btn" style="display: none;" onclick="showWrongBook()">📖 查看錯題溫習筆記</button>
                <button class="btn btn-accent" onclick="goToScreen('screen-home')">🏠 返回首頁</button>
                <button class="btn btn-secondary" onclick="showLeaderboard()">🏆 查看排行榜</button>
            </div>
        </div>

        <!-- 7. 排行榜畫面 -->
        <div id="screen-leaderboard" class="screen">
            <h2>🏆 實驗室英雄排行榜</h2>
            <p>紀錄本機前幾名的化學菁英：</p>
            <div id="leaderboard-content"></div>
            <button class="btn btn-secondary" onclick="goToScreen('screen-home')">🏠 返回首頁</button>
        </div>

        <!-- 8. 錯題本畫面 -->
        <div id="screen-wrong-book" class="screen">
            <h2>📖 錯題溫習筆記</h2>
            <p>以下是您本次挑戰答錯或超時的題目，建議加強複習：</p>
            <div id="wrong-list-content" style="max-height: 320px; overflow-y: auto; padding-right: 5px;"></div>
            <button class="btn btn-secondary" onclick="goToScreen('screen-result')">⬅️ 返回結算頁</button>
        </div>
    </div>

    <script>
        // ------------------ 語音與音效系統 ------------------
        let audioCtx = null;
        let isAudioEnabled = true;
        let bgmInterval = null;

        function initAudio() {
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) {}
        }

        function toggleAudio() {
            initAudio();
            isAudioEnabled = !isAudioEnabled;
            const btn = document.querySelector('.audio-control');
            if (isAudioEnabled) {
                btn.innerText = "🔊 音效：開啟";
                playBGM();
            } else {
                btn.innerText = "🔇 音效：關閉";
                stopBGM();
            }
        }

        function playCorrectSound() {
            if (!isAudioEnabled || !audioCtx) return;
            try {
                const notes = [523.25, 659.25, 783.99, 1046.50];
                notes.forEach((freq, idx) => {
                    setTimeout(() => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start();
                        osc.stop(audioCtx.currentTime + 0.3);
                    }, idx * 80);
                });
            } catch (e) {}
        }

        function playWrongSound() {
            if (!isAudioEnabled || !audioCtx) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(90, audioCtx.currentTime + 0.3);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.3);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.3);
            } catch (e) {}
        }

        function playBGM() {
            if (bgmInterval) return;
            const chordProgression = [
                [261.63, 329.63, 392.00],
                [220.00, 261.63, 329.63],
                [174.61, 220.00, 261.63],
                [196.00, 246.94, 293.66]
            ];
            let step = 0;
            bgmInterval = setInterval(() => {
                if (!isAudioEnabled || !audioCtx) return;
                try {
                    const chord = chordProgression[step % chordProgression.length];
                    step++;
                    chord.forEach(freq => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq / 2, audioCtx.currentTime);
                        gain.gain.setValueAtTime(0.025, audioCtx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.8);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start();
                        osc.stop(audioCtx.currentTime + 1.8);
                    });
                } catch (e) {}
            }, 2000);
        }

        function stopBGM() {
            if (bgmInterval) {
                clearInterval(bgmInterval);
                bgmInterval = null;
            }
        }

        // ------------------ 題庫 (簡單50題、困難50題，完全對應初中+高一指定知識範圍) ------------------
        const questionBank = {
            easy: [
                { q: "下列元素符號書寫完全正確的是哪一個？", options: ["① 銅 cu", "② 鈉 NA", "③ 鎂 Mg", "④ 鈣 CA"], answer: 2, explanation: "鎂的正確符號是 Mg；銅是 Cu；鈉是 Na；鈣是 Ca（一大二小規則）。" },
                { q: "空氣中體積分數約佔 78% 的氣體元素，其符號是什麼？", options: ["O", "N", "C", "H"], answer: 1, explanation: "空氣中體積分數最大的是氮氣（N<sub>2</sub>），元素為氮，符號 N。" },
                { q: "地殼中含量最多的金屬元素是什麼？", options: ["鐵 (Fe)", "鋁 (Al)", "鈣 (Ca)", "銅 (Cu)"], answer: 1, explanation: "地殼中元素含量前三位是：氧、矽、鋁，故最多金屬為鋁。" },
                { q: "已知氫顯 +1 價，氧顯 -2 價，水的正確化學式為何？", options: ["HO", "H<sub>2</sub>O", "H<sub>2</sub>O<sub>2</sub>", "HO<sub>2</sub>"], answer: 1, explanation: "(+1)×2 + (-2)×1 = 0，故水為 H<sub>2</sub>O。" },
